# Caddy reverse proxy for aniicrite.dev.
# Auto-provisions Let's Encrypt TLS. The Go binary listens on 127.0.0.1:8091
# (the compose.yaml port mapping); Caddy is the only public-facing process.
# This block lives inside the server's shared /etc/caddy/Caddyfile.

aniicrite.dev {
	encode zstd gzip
	reverse_proxy http://127.0.0.1:8091

	# Long-cache static assets; HTML stays uncached so edits show immediately.
	@static path /static/* /uploads/*
	header @static Cache-Control "public, max-age=604800"
}

# 301 the old domain to the new canonical host, preserving the path.
meanii.dev, www.meanii.dev, www.aniicrite.dev {
	redir https://aniicrite.dev{uri} permanent
}
