# Copy to /opt/aniicrite/.env and fill in. Loaded by the systemd unit.

APP_ENV=production
APP_ADDR=127.0.0.1:8080          # bind localhost; Caddy fronts it
BASE_URL=https://aniicrite.dev
DATA_DIR=/opt/aniicrite/data

# Admin login. Generate with:  ./aniicrite hash-password 'your-strong-password'
# NOTE (Docker Compose only): double every '$' in the hash ($ -> $$) so Compose
# does not interpolate it, e.g. $$argon2id$$v=19$$m=65536,...
ADMIN_PASSWORD_HASH=

# Cookie signing/encryption keys. Generate each with:  openssl rand -hex 32
SESSION_HASH_KEY=
SESSION_BLOCK_KEY=

# GitHub OAuth for commenters. Create an OAuth App with callback:
#   https://aniicrite.dev/auth/github/callback
# Leave blank to keep comments disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Site identity.
SITE_TITLE=My Site
SITE_DESC=A personal site and blog.
AUTHOR_NAME=Your Name
AUTHOR_BIO=Short bio about you.
AVATAR_URL=
OG_IMAGE=/static/og-default.png

# Footer + JSON-LD profile links: "Label|URL" pairs, comma-separated.
SOCIAL_LINKS=GitHub|https://github.com/you,Email|mailto:you@example.com
